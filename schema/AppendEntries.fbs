// leaderid
// prevLogIndex
// prevLogTerm
// entries [] -- empty for heartbeat
// leaderCommit

// -- returns 
// term
// success: bool

table LogEntry {
    term:int;
    command:string;
}

table AppendEntriesRPC {
    term:int;
    leader_id:int;
    prev_log_index:int;
    prev_log_term:int;
    entries:[LogEntry];
    leader_commit:int;
}

root_type AppendEntriesRPC;
